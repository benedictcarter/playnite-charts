<UserControl x:Class="PlayniteCharts.Views.ChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayniteCharts.Controls"
             xmlns:model="clr-namespace:PlayniteCharts.Model"
             xmlns:vm="clr-namespace:PlayniteCharts.ViewModels"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Foreground="{DynamicResource TextBrush}"
             TextElement.Foreground="{DynamicResource TextBrush}"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,7,0,2" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <!-- the row's delete affordance: no button chrome, just the glyph -->
        <Style x:Key="RowDelete" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="6,1">
                            <TextBlock Text="&#x2715;" FontSize="11"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type model:PlotConfig}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource RowDelete}"
                        ToolTip="Delete this plot"
                        Command="{Binding DataContext.DeletePlotCommand,
                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <!-- the create row: looks like the last line of the list, behaves like a button -->
        <Style x:Key="NewPlotRow" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" Padding="4,3">
                            <TextBlock Text="New" FontStyle="Italic" Opacity="0.7"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource NormalBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="3,0,0,0" />
        </Style>

        <!-- one filter: a range for numbers and dates, a tick list for the rest -->
        <DataTemplate DataType="{x:Type vm:FilterViewModel}">
            <Border BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}"
                    Padding="5,3,3,5" Margin="0,0,0,5">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource RowDelete}"
                                ToolTip="Remove this filter"
                                Command="{Binding DataContext.RemoveFilterCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" />
                    </DockPanel>

                    <StackPanel Visibility="{Binding IsRange, Converter={StaticResource BoolToVis}}">
                        <controls:RangeSlider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                              Lower="{Binding Lower}" Upper="{Binding Upper}"
                                              Step="{Binding Step}" Margin="0,2,0,0"
                                              TrackBrush="{DynamicResource NormalBorderBrush}"
                                              AccentBrush="{DynamicResource GlyphBrush}" />
                        <TextBlock Text="{Binding RangeText}" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextBrushDarker}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsList, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="False" Margin="0,2,0,2">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrushDarker}" />
                            <Button DockPanel.Dock="Right" Content="None" Style="{StaticResource MiniButton}"
                                    Command="{Binding NoneCommand}" />
                            <Button DockPanel.Dock="Right" Content="All" Style="{StaticResource MiniButton}"
                                    Command="{Binding AllCommand}" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                            <ItemsControl ItemsSource="{Binding Values}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                  Margin="2,1" Foreground="{DynamicResource TextBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="210" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- saved plots + the settings for the selected one -->
        <Grid Grid.Column="0" Margin="10,8,6,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- the saved list is sized by its contents, so it grows a row at a
                     time and never leaves an empty box under the New button -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="SAVED PLOTS" Style="{StaticResource SectionHeader}"
                       Margin="0,0,0,5" />

            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}"
                    MaxHeight="320">
                <!-- stacked, not docked, so "New" sits right under the last plot -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ListBox x:Name="PlotList" ItemsSource="{Binding Plots}" SelectedItem="{Binding SelectedPlot}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch" AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnPlotListMouseDown"
                             PreviewMouseMove="OnPlotListMouseMove"
                             DragOver="OnPlotListDragOver" Drop="OnPlotListDrop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="ToolTip" Value="Drag to reorder" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Duplicate"
                                                      Command="{Binding PlacementTarget.DataContext.DuplicatePlotCommand,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        </ListBox>
                        <Button Style="{StaticResource NewPlotRow}"
                                ToolTip="Add a new plot" Command="{Binding NewPlotCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <ScrollViewer Grid.Row="2" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                          Visibility="{Binding HasPlot, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding SelectedPlot}">
                    <TextBlock Text="NAME" Style="{StaticResource SectionHeader}" Margin="0,4,0,3" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Text="CHANNELS" Style="{StaticResource SectionHeader}" />

                    <TextBlock Text="X axis" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding XFieldId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                              ItemsSource="{Binding DataContext.XFields,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Text="Y axis" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding YFieldId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                              ItemsSource="{Binding DataContext.YFields,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Text="Bubble size" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding SizeFieldId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                              ItemsSource="{Binding DataContext.SizeFields,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Text="Colour" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding ColorFieldId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                              ItemsSource="{Binding DataContext.ColorFields,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Text="Shape" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding ShapeFieldId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                              ItemsSource="{Binding DataContext.ShapeFields,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="HOVER  (all plots)" Style="{StaticResource SectionHeader}" />
                        <Button DockPanel.Dock="Right" Content="None" Padding="6,0" Margin="3,8,0,2" FontSize="10"
                                ToolTip="Hover shows nothing but the name"
                                Command="{Binding DataContext.NoHoverCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button DockPanel.Dock="Right" Content="All" Padding="6,0" Margin="3,8,0,2" FontSize="10"
                                ToolTip="Hover shows every column the game has a value for"
                                Command="{Binding DataContext.AllHoverCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </DockPanel>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}" Padding="4"
                            MaxHeight="240">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DataContext.HoverOptions,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="2"
                                                  Foreground="{DynamicResource TextBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="FILTERS  (all plots)" Style="{StaticResource SectionHeader}" />
                        <Button x:Name="AddFilterButton" DockPanel.Dock="Right" Content="Add"
                                Padding="6,0" Margin="3,8,0,2" FontSize="10" Click="OnAddFilterClick"
                                ToolTip="Filter the plotted games by any column">
                            <Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding FilterFields}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.AddFilterCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button DockPanel.Dock="Right" Content="Clear" Padding="6,0" Margin="3,8,0,2" FontSize="10"
                                ToolTip="Remove every filter from this plot"
                                Command="{Binding DataContext.ClearFiltersCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding DataContext.Filters,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock Text="No filters - everything is plotted" FontSize="11" FontStyle="Italic"
                               Margin="0,0,0,4" Foreground="{DynamicResource TextBrushDarker}"
                               Visibility="{Binding DataContext.HasFilters,
                                   RelativeSource={RelativeSource AncestorType=UserControl},
                                   Converter={StaticResource InverseBoolToVis}}" />
                    <CheckBox Content="Use library filter" Margin="0,3,0,4"
                              Foreground="{DynamicResource TextBrush}"
                              ToolTip="Plot only the games the library view's filter currently shows, before these filters run"
                              IsChecked="{Binding DataContext.UseLibraryFilter,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Text="APPEARANCE  (all plots)" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Show legend" IsChecked="{Binding DataContext.View.ShowLegend, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,3"
                              Foreground="{DynamicResource TextBrush}" />
                    <CheckBox Content="Show game titles"
                              IsChecked="{Binding DataContext.View.ShowTitles, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,3"
                              Foreground="{DynamicResource TextBrush}"
                              ToolTip="Write each game's name beside its bubble. Where names collide the one with the higher user score keeps its label; hovering always shows the name." />
                    <CheckBox Content="Count a missing number as 0" IsChecked="{Binding DataContext.View.MissingAsZero, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,3"
                              Foreground="{DynamicResource TextBrush}"
                              ToolTip="Plot games with no user score, no critic score etc. at zero instead of leaving them out. Dates are never zeroed." />

                    <TextBlock Text="Colour ramp" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding DataContext.View.ColorRampId, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedValuePath="Id"
                              ItemsSource="{Binding DataContext.ColorRamps, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              ToolTip="Used when the colour column holds numbers or dates - the value is read straight off the ramp. A text column still uses the fixed category palette.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Left" Width="46" Height="12" RadiusX="2" RadiusY="2"
                                               Margin="0,0,8,0" VerticalAlignment="Center"
                                               Fill="{Binding Preview}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Smallest" Width="70" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" Opacity="0.8" />
                        <TextBlock DockPanel.Dock="Right" Width="28" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding DataContext.View.MinBubbleSize, StringFormat={}{0:0}, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Slider Minimum="3" Maximum="16" Value="{Binding DataContext.View.MinBubbleSize, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,4,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="Largest" Width="70" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" Opacity="0.8" />
                        <TextBlock DockPanel.Dock="Right" Width="28" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding DataContext.View.MaxBubbleSize, StringFormat={}{0:0}, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Slider Minimum="6" Maximum="48" Value="{Binding DataContext.View.MaxBubbleSize, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- the plot -->
        <Grid Grid.Column="2" Margin="6,8,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Text="{Binding SourceSummary}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" Opacity="0.75" />
            </DockPanel>

            <controls:BubblePlotControl x:Name="Plot" Grid.Row="1" Model="{Binding Model}" />
        </Grid>
    </Grid>
</UserControl>
