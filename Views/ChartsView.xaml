<UserControl x:Class="PlayniteCharts.Views.ChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PlayniteCharts.Controls"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Foreground="{DynamicResource TextBrush}"
             TextElement.Foreground="{DynamicResource TextBrush}"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,7,0,2" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="210" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- saved plots + the settings for the selected one -->
        <Grid Grid.Column="0" Margin="10,8,6,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="90" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,5">
                <TextBlock DockPanel.Dock="Left" Text="SAVED PLOTS" VerticalAlignment="Center"
                           Style="{StaticResource SectionHeader}" Margin="0" />
                <Button DockPanel.Dock="Right" Content="&#x2715;" Width="26" Margin="3,0,0,0"
                        ToolTip="Delete the selected plot" Command="{Binding DeletePlotCommand}" />
                <Button DockPanel.Dock="Right" Content="&#x29C9;" Width="26" Margin="3,0,0,0"
                        ToolTip="Duplicate the selected plot" Command="{Binding DuplicatePlotCommand}" />
                <Button DockPanel.Dock="Right" Content="&#x2795;" Width="26"
                        ToolTip="New plot" Command="{Binding NewPlotCommand}" />
            </DockPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Plots}" SelectedItem="{Binding SelectedPlot}"
                     DisplayMemberPath="Name" HorizontalContentAlignment="Stretch" />

            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                          Visibility="{Binding HasPlot, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding SelectedPlot}">
                    <TextBlock Text="NAME" Style="{StaticResource SectionHeader}" Margin="0,4,0,3" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="CHANNELS" Style="{StaticResource SectionHeader}" />

                    <TextBlock Text="X axis" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding XFieldId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                              ItemsSource="{Binding DataContext.XFields,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Text="Y axis" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding YFieldId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                              ItemsSource="{Binding DataContext.YFields,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Text="Bubble size" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding SizeFieldId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                              ItemsSource="{Binding DataContext.SizeFields,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Text="Colour" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding ColorFieldId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                              ItemsSource="{Binding DataContext.ColorFields,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <TextBlock Text="Shape" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding ShapeFieldId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                              ItemsSource="{Binding DataContext.ShapeFields,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="HOVER" Style="{StaticResource SectionHeader}" />
                        <Button DockPanel.Dock="Right" Content="None" Padding="6,0" Margin="3,8,0,2" FontSize="10"
                                ToolTip="Hover shows nothing but the name"
                                Command="{Binding DataContext.NoHoverCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button DockPanel.Dock="Right" Content="All" Padding="6,0" Margin="3,8,0,2" FontSize="10"
                                ToolTip="Hover shows every column the game has a value for"
                                Command="{Binding DataContext.AllHoverCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </DockPanel>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}" Padding="4"
                            MaxHeight="240">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DataContext.HoverOptions,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="2"
                                                  Foreground="{DynamicResource TextBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Show legend" IsChecked="{Binding ShowLegend}" Margin="0,3"
                              Foreground="{DynamicResource TextBrush}" />

                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Smallest" Width="70" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" Opacity="0.8" />
                        <TextBlock DockPanel.Dock="Right" Width="28" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding MinBubbleSize, StringFormat={}{0:0}}" />
                        <Slider Minimum="3" Maximum="16" Value="{Binding MinBubbleSize}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,4,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="Largest" Width="70" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" Opacity="0.8" />
                        <TextBlock DockPanel.Dock="Right" Width="28" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding MaxBubbleSize, StringFormat={}{0:0}}" />
                        <Slider Minimum="6" Maximum="48" Value="{Binding MaxBubbleSize}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- the plot -->
        <Grid Grid.Column="2" Margin="6,8,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Text="{Binding SourceSummary}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" Opacity="0.75" />
                <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,3" Margin="6,0,0,0"
                        Command="{Binding RefreshCommand}" />
                <CheckBox DockPanel.Dock="Right" Content="Table" VerticalAlignment="Center" Margin="12,0,0,0"
                          Foreground="{DynamicResource TextBrush}"
                          ToolTip="Show the plotted rows as text instead of marks"
                          IsChecked="{Binding ShowTable}" />
                <CheckBox DockPanel.Dock="Right" Content="Use library filter" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextBrush}"
                          ToolTip="Plot only the games the library view's filter currently shows"
                          IsChecked="{Binding UseLibraryFilter}" />
            </DockPanel>

            <controls:BubblePlotControl x:Name="Plot" Grid.Row="1" Model="{Binding Model}"
                                        Visibility="{Binding ShowPlot, Converter={StaticResource BoolToVis}}" />

            <ListView x:Name="Table" Grid.Row="1" ItemsSource="{Binding TableRows}"
                      Visibility="{Binding ShowTable, Converter={StaticResource BoolToVis}}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView x:Name="TableGrid" />
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
